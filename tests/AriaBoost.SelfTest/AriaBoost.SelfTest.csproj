<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Gerçek Windows üzerinde (CI'daki windows-latest) her optimizasyonu uygulayıp
    geri alan ve sistemin ilk hâline döndüğünü doğrulayan test programı.
    Uygulamanın Core kodunu doğrudan derler.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AriaBoost.SelfTest</AssemblyName>
    <RootNamespace>AriaBoost.SelfTest</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\AriaBoost\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\src\AriaBoost\UI\Theme.xaml" LogicalName="AriaBoost.Theme.xaml" />
  </ItemGroup>
</Project>
